<Window x:Class="VisualFolderExplorer.Windows.MoveImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="680" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <Border Style="{StaticResource CardBorder}" Margin="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="14"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="18"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="SourceLabel" Grid.Row="0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceBox" Grid.Column="0" Height="42"/>
                    <Button x:Name="SourceBrowseButton" Grid.Column="1" MinWidth="90" Margin="8,0,0,0" Click="SourceBrowseButton_Click"/>
                </Grid>
            </Grid>

            <Grid Grid.Row="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="6"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock x:Name="DestinationLabel" Grid.Row="0" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource MutedTextBrush}"/>
                <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="DestinationBox" Grid.Column="0" Height="42"/>
                    <Button x:Name="DestinationBrowseButton" Grid.Column="1" MinWidth="90" Margin="8,0,0,0" Click="DestinationBrowseButton_Click"/>
                </Grid>
            </Grid>

            <TextBlock x:Name="HintText" Grid.Row="6" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
            <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button x:Name="MoveButton" MinWidth="110" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="MoveButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
