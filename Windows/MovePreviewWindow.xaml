<Window x:Class="VisualFolderExplorer.Windows.MovePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="560" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="DestinationText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="CountText" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
                <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,6" Margin="12,0,0,0">
                    <TextBlock x:Name="ConflictText" Foreground="#174E7D" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="8">
            <DataGrid x:Name="PreviewGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                      GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowHeaderWidth="0">
                <DataGrid.Columns>
                    <DataGridTextColumn x:Name="SourceColumn" Binding="{Binding SourceName}" Width="*"/>
                    <DataGridTextColumn x:Name="DestinationColumn" Binding="{Binding DestinationName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="CancelButton" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="ConfirmButton" MinWidth="130" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="ConfirmButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
