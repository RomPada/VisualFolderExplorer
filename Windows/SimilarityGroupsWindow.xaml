<Window x:Class="VisualFolderExplorer.Windows.SimilarityGroupsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1120" Height="740" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="IntroText" Margin="0,5,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" MaxWidth="820"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="9" Padding="11,7" Margin="12,0,0,0" VerticalAlignment="Top">
                <TextBlock x:Name="LocalBadgeText" Foreground="#174E7D" FontWeight="SemiBold"/>
            </Border>
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="250"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="18"/>
                    <ColumnDefinition Width="210"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="ThresholdLabel" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                        <Slider x:Name="ThresholdSlider" Grid.Column="0" Minimum="65" Maximum="98" Value="88" TickFrequency="1" SmallChange="1" LargeChange="3" ValueChanged="ThresholdSlider_ValueChanged" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ThresholdValueText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock x:Name="ThresholdHintText" Foreground="{StaticResource MutedTextBrush}" FontSize="12" TextWrapping="Wrap"/>
                    <TextBlock x:Name="GroupSummaryText" Margin="0,7,0,0" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock x:Name="PrefixLabel" Foreground="{StaticResource MutedTextBrush}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBox x:Name="PrefixBox" Height="36" Margin="0,6,0,0" Text="Similar"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}"/>
                <ProgressBar x:Name="AnalysisProgress" Height="5" Margin="0,7,0,0" Minimum="0" Maximum="100" Value="0"/>
            </StackPanel>
            <Button x:Name="ReanalyzeButton" Grid.Column="1" MinWidth="125" Height="34" Margin="12,0,0,0" Click="ReanalyzeButton_Click"/>
        </Grid>

        <Border Grid.Row="6" Style="{StaticResource CardBorder}" Padding="10">
            <Grid>
                <ScrollViewer x:Name="GroupsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="GroupsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,10" Background="#FCFDFE">
                                    <StackPanel>
                                        <Grid Margin="2,0,2,9">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                                            <TextBlock Grid.Column="1" Foreground="{StaticResource MutedTextBrush}">
                                                <Run Text="{Binding AverageSimilarity, StringFormat={}{0:0.0}%}"/>
                                            </TextBlock>
                                        </Grid>
                                        <ItemsControl ItemsSource="{Binding Images}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="145" Height="150" Margin="3" Padding="6" Background="White" BorderBrush="#E0E6EB" BorderThickness="1" CornerRadius="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                            <Border Grid.Row="0" Background="#ECEFF2" CornerRadius="6" ClipToBounds="True">
                                                                <Grid>
                                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                                                    <CheckBox IsChecked="{Binding IsIncluded}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Click="ImageIncludeCheckBox_Click"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,6,2,0" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="520">
                    <TextBlock Text="◎" FontSize="38" HorizontalAlignment="Center" Foreground="#B9C5CE"/>
                    <TextBlock x:Name="EmptyTitleText" Margin="0,10,0,0" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                    <TextBlock x:Name="EmptyHintText" Margin="0,6,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="BottomHintText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap" Margin="2,0,16,0"/>
            <Button x:Name="CloseButton" Grid.Column="1" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="CloseButton_Click"/>
            <Button x:Name="ApplyButton" Grid.Column="2" MinWidth="200" Style="{StaticResource PrimaryButton}" Click="ApplyButton_Click" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
