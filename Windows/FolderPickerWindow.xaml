<Window x:Class="VisualFolderExplorer.Windows.FolderPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" Height="560" MinWidth="620" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Background="{StaticResource WindowBg}">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="170"/><ColumnDefinition Width="10"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="PathLabel" Grid.Row="0" Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                <TextBlock x:Name="DriveLabel" Grid.Row="0" Grid.Column="2" Foreground="{StaticResource MutedTextBrush}" FontWeight="SemiBold" FontSize="12"/>
                <TextBox x:Name="PathBox" Grid.Row="2" Grid.Column="0" Height="42" KeyDown="PathBox_KeyDown"/>
                <ComboBox x:Name="DriveCombo" Grid.Row="2" Grid.Column="2" Height="42" SelectionChanged="DriveCombo_SelectionChanged"/>
                <Button x:Name="UpButton" Grid.Row="2" Grid.Column="4" MinWidth="92" Height="42" Click="UpButton_Click"/>
            </Grid>
        </Border>
        <Border Grid.Row="4" Style="{StaticResource CardBorder}" Padding="8">
            <Grid>
                <ListBox x:Name="FolderList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource ExplorerItemStyle}" DisplayMemberPath="Name" MouseDoubleClick="FolderList_MouseDoubleClick" SelectionChanged="FolderList_SelectionChanged"/>
                <TextBlock x:Name="EmptyText" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock x:Name="SelectionHint" Grid.Column="0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="2,0,12,0"/>
            <Button x:Name="CancelButton" Grid.Column="1" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
            <Button x:Name="SelectButton" Grid.Column="2" MinWidth="120" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="SelectButton_Click"/>
        </Grid>
    </Grid>
</Window>
