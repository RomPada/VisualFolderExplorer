<Window x:Class="VisualFolderExplorer.Windows.DuplicateResultsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1080" Height="650" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="8"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="14"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" Grid.Row="0" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
        <TextBlock x:Name="SummaryText" Grid.Row="2" Foreground="{StaticResource MutedTextBrush}"/>

        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                <DataGrid x:Name="ResultsGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" BorderThickness="0" Background="Transparent" RowHeaderWidth="0"
                          SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ResultsGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn x:Name="GroupColumn" Binding="{Binding GroupNumber}" Width="75"/>
                        <DataGridTextColumn x:Name="NameColumn" Binding="{Binding Name}" Width="220"/>
                        <DataGridTextColumn x:Name="SizeColumn" Binding="{Binding SizeText}" Width="95"/>
                        <DataGridTextColumn x:Name="PathColumn" Binding="{Binding FullPath}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock x:Name="PreviewTitle" Grid.Row="0" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource TextBrush}"/>
                    <Border Grid.Row="2" Background="#111418" CornerRadius="8" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="PreviewImage" Stretch="Uniform"/>
                            <TextBlock x:Name="PreviewPlaceholder" Foreground="#DCE4E9" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" Margin="18"/>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="4">
                        <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="PreviewMeta" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="DeleteAllConflictsButton" Grid.Column="1" MinWidth="165" Margin="0,0,8,0" Click="DeleteAllConflictsButton_Click"/>
            <Button x:Name="DeleteButton" Grid.Column="2" MinWidth="130" Margin="0,0,8,0" Click="DeleteButton_Click"/>
            <Button x:Name="CloseButton" Grid.Column="3" MinWidth="100" Margin="0,0,8,0" IsCancel="True" Click="CloseButton_Click"/>
            <Button x:Name="SelectButton" Grid.Column="4" MinWidth="170" Style="{StaticResource PrimaryButton}" Click="SelectButton_Click"/>
        </Grid>
    </Grid>
</Window>
