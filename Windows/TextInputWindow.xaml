<Window x:Class="VisualFolderExplorer.Windows.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <Border Style="{StaticResource CardBorder}" Margin="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="PromptText" Grid.Row="0" Foreground="{StaticResource TextBrush}" FontSize="14" TextWrapping="Wrap"/>
            <TextBox x:Name="ValueBox" Grid.Row="2" Height="40"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" MinWidth="92" Margin="0,0,8,0" IsCancel="True" Click="CancelButton_Click"/>
                <Button x:Name="OkButton" MinWidth="92" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OkButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
