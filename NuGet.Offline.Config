<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- This project has no third-party NuGet packages.
         Clearing sources prevents corporate firewalls from breaking restore
         when api.nuget.org is blocked. Framework reference packs come from
         the locally installed .NET SDK when building from source. -->
    <clear />
  </packageSources>
  <config>
    <add key="dependencyVersion" value="Lowest" />
  </config>
</configuration>
