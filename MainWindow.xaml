<Window x:Class="VisualFolderExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:VisualFolderExplorer.Models"
        Title="Visual Folder Explorer v1.0.0"
        Width="1420" Height="820" MinWidth="1050" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="{StaticResource WindowBg}"
        Closing="Window_Closing" Loaded="Window_Loaded" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="BackButton" Grid.Column="0" Style="{StaticResource NavButton}" Content="←" Margin="0,0,6,0" Click="BackButton_Click"/>
                <Button x:Name="UpButton" Grid.Column="1" Style="{StaticResource NavButton}" Content="↑" Margin="0,0,6,0" Click="UpButton_Click"/>
                <Button x:Name="HomeButton" Grid.Column="2" Style="{StaticResource NavButton}" Content="⌂" Margin="0,0,10,0" Click="HomeButton_Click"/>
                <TextBox x:Name="PathBox" Grid.Column="3" Height="36" IsReadOnly="True" Margin="0,0,10,0"/>
                <Button x:Name="ChooseFolderButton" Grid.Column="4" Margin="0,0,8,0" Click="ChooseFolderButton_Click"/>
                <Button x:Name="MoveImagesButton" Grid.Column="5" Margin="0,0,8,0" Click="MoveImagesButton_Click"/>
                <ComboBox x:Name="LanguageCombo" Grid.Column="6" Width="82" Height="36" SelectionChanged="LanguageCombo_SelectionChanged">
                    <ComboBoxItem Content="UA" Tag="UA"/><ComboBoxItem Content="EN" Tag="EN"/>
                </ComboBox>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="430"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock x:Name="ExplorerTitle" Grid.Row="0" FontWeight="SemiBold" FontSize="16" Foreground="{StaticResource TextBrush}"/>
                    <ListBox x:Name="ExplorerList" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource ExplorerItemStyle}"
                             SelectionChanged="ExplorerList_SelectionChanged"
                             MouseDoubleClick="ExplorerList_MouseDoubleClick"
                             PreviewMouseRightButtonUp="ExplorerList_PreviewMouseRightButtonUp">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ExplorerItem}">
                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="170"/><ColumnDefinition Width="148"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="ImagesTitle" Grid.Column="0" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center" Foreground="{StaticResource TextBrush}"/>
                        <ComboBox x:Name="SortFieldCombo" Grid.Column="2" Height="34" Margin="10,0,8,0" SelectionChanged="SortCombo_SelectionChanged">
                            <ComboBoxItem Tag="Name"/><ComboBoxItem Tag="Modified"/><ComboBoxItem Tag="Created"/><ComboBoxItem Tag="Size"/>
                        </ComboBox>
                        <ComboBox x:Name="SortDirectionCombo" Grid.Column="3" Height="34" Margin="0,0,10,0" SelectionChanged="SortCombo_SelectionChanged">
                            <ComboBoxItem Tag="Ascending"/><ComboBoxItem Tag="Descending"/>
                        </ComboBox>
                        <TextBlock x:Name="ImageCountText" Grid.Column="4" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListBox x:Name="ImageList" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 SelectionMode="Extended"
                                 ItemContainerStyle="{StaticResource ImageTileStyle}"
                                 SelectionChanged="ImageList_SelectionChanged"
                                 PreviewMouseRightButtonUp="ImageList_PreviewMouseRightButtonUp">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type models:ImageItem}">
                                    <Grid Margin="7">
                                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                        <Border Grid.Row="0" Background="#ECEFF2" CornerRadius="7" ClipToBounds="True">
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="3,7,3,0" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Canvas x:Name="ImageMarkerLayer" HorizontalAlignment="Right" Width="12" IsHitTestVisible="False" Panel.ZIndex="50" Margin="0,3,0,3" SizeChanged="ImageMarkerLayer_SizeChanged">
                            <Border x:Name="ImageScrollMarker" Width="8" Height="4" Canvas.Left="2" Background="{StaticResource AccentBrush}" CornerRadius="2" Visibility="Collapsed"/>
                        </Canvas>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent"/>

            <Border Grid.Column="4" Style="{StaticResource CardBorder}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="10"/><RowDefinition Height="*"/><RowDefinition Height="10"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="BackToTextButton" Grid.Row="0" Grid.Column="0" Visibility="Collapsed" Margin="0,0,8,0" Click="BackToTextButton_Click"/>
                        <TextBlock x:Name="SideTitle" Grid.Row="0" Grid.Column="1" FontWeight="SemiBold" FontSize="16" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="MarkdownModeButton" Visibility="Collapsed" Margin="0,0,8,0" Click="MarkdownModeButton_Click"/>
                            <Button x:Name="SaveTextButton" Click="SaveTextButton_Click" IsEnabled="False"/>
                        </StackPanel>
                        <Border Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="9,6" Background="#F5F7F9" CornerRadius="7">
                            <TextBlock x:Name="TextFileName" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Background="#FBFCFD" ClipToBounds="True">
                        <Grid>
                            <TextBox x:Name="TextEditor" Style="{x:Null}" BorderThickness="0" Background="Transparent" Padding="12"
                                     TextWrapping="Wrap" AcceptsReturn="True" AcceptsTab="True"
                                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                     FontSize="14" Foreground="#252A2E" TextChanged="TextEditor_TextChanged" PreviewMouseRightButtonUp="TextEditor_PreviewMouseRightButtonUp"/>
                            <FlowDocumentScrollViewer x:Name="MarkdownViewer" Visibility="Collapsed" IsToolBarVisible="False" Background="Transparent"/>
                            <Grid x:Name="PreviewPanel" Visibility="Collapsed" Background="#111418" ClipToBounds="True"
                                  MouseLeftButtonDown="PreviewPanel_MouseLeftButtonDown" MouseLeftButtonUp="PreviewPanel_MouseLeftButtonUp" MouseMove="PreviewPanel_MouseMove">
                                <Image x:Name="PreviewImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"/>
                                <TextBlock x:Name="PreviewError" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TextCounter" Grid.Column="0" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}"/>
                        <Button x:Name="PreviousTextButton" Grid.Column="1" Style="{StaticResource NavButton}" Content="←" Margin="0,0,6,0" Click="PreviousTextButton_Click"/>
                        <Button x:Name="NextTextButton" Grid.Column="2" Style="{StaticResource NavButton}" Content="→" Margin="0" Click="NextTextButton_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,6">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedTextBrush}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
